{
  "manifest_version": 3,
  "name": "Etch Detector",
  "version": "0.2.0",
  "description": "Shows whether the current site is built with EtchWP (WordPress plugin) or Etch Studio.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "detect.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Etch Detector",
    "default_popup": "popup.html"
  }
}
